# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# XTracker API — comma-separate multiple keys for faster clan scans (one parallel slot per key)
XTRACKER_API_KEY=key_one,key_two,key_three

# Admin key for protected submit routes
ADMIN_SECRET=your_strong_secret_here

# Discord Bot Token (optional - for resolving usernames via Discord API)
DISCORD_BOT_TOKEN=your_discord_bot_token
